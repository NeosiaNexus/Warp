{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Warp chart values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": { "type": "object" },
    "replicaCount": { "type": "integer", "minimum": 0 },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^(sha256:[a-f0-9]{64})?$" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": { "type": "array" },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "onlineMode": { "type": "boolean" },
        "servers": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              { "type": "string", "minLength": 1 },
              { "type": "object", "required": ["address"], "properties": { "address": { "type": "string", "minLength": 1 } } }
            ]
          }
        },
        "defaultServer": { "type": "string", "minLength": 1 },
        "fallbackOrder": { "type": "array", "items": { "type": "string" } },
        "groups": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["servers"],
            "properties": {
              "servers": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
              "strategy": { "type": "string", "enum": ["round-robin", "least-connections", "lowest-latency", "random", "weighted", "fill"] },
              "weights": { "type": "object" },
              "capacity": { "type": "integer" }
            }
          }
        },
        "routes": { "type": "object", "additionalProperties": { "type": "string" } },
        "acceptsTransfers": { "type": "boolean" },
        "forwarding": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "mode": { "type": "string", "enum": ["velocity", "none"] } }
        },
        "playerLimit": { "type": "integer", "minimum": -1 },
        "status": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "motd": { "type": ["string", "array"] },
            "maxPlayers": { "type": ["integer", "string"] }
          }
        },
        "compression": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "threshold": { "type": "integer", "minimum": -1 },
            "passthrough": { "type": "boolean" }
          }
        },
        "logging": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "format": { "type": "string", "enum": ["json", "text"] } }
        },
        "proxyProtocol": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "trustedProxies": { "type": "array", "items": { "type": "string" } }
          }
        },
        "extra": { "type": "string" },
        "raw": { "type": "string" }
      }
    },
    "drain": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "transferTo": { "type": "string" },
        "propagationDelay": { "$ref": "#/definitions/duration" },
        "transferInterval": { "$ref": "#/definitions/duration" },
        "cannotTransfer": { "type": "string", "enum": ["keep", "kick"] },
        "newPlayers": { "type": "string", "enum": ["accept", "refuse"] },
        "timeout": { "$ref": "#/definitions/duration" },
        "gracePeriodMargin": { "type": "integer", "minimum": 0 },
        "mode": { "type": "string", "enum": ["sigterm", "preStop"] }
      }
    },
    "management": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "readyRequiresServer": { "type": "boolean" },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "enabled": { "type": "boolean" }, "secretName": { "type": "string" } }
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "requireToken": { "type": "boolean" },
            "serverPingInterval": { "$ref": "#/definitions/duration" },
            "serviceMonitor": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "interval": { "type": "string" },
                "scrapeTimeout": { "type": "string" },
                "labels": { "type": "object" },
                "namespace": { "type": "string" },
                "relabelings": { "type": "array" },
                "metricRelabelings": { "type": "array" },
                "insecureSkipVerify": { "type": "boolean" }
              }
            },
            "podAnnotations": { "type": "boolean" }
          }
        },
        "console": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "tokens": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "scopes", "secretKey"],
                "properties": {
                  "name": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
                  "scopes": { "type": "array", "items": { "type": "string", "enum": ["logs", "commands"] }, "minItems": 1 },
                  "secretKey": { "type": "string", "minLength": 1 },
                  "generate": { "type": "boolean" }
                }
              }
            },
            "trustedNetworks": { "type": "array", "items": { "type": "string" } },
            "history": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": { "type": "string" },
        "forwardingSecretKey": { "type": "string", "minLength": 1 },
        "managementTokenKey": { "type": "string", "minLength": 1 },
        "forwardingSecret": { "type": "string" },
        "managementToken": { "type": "string" },
        "antiBot": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "shared": { "type": "boolean" },
            "secret": { "type": "string" },
            "tokenSecret": { "type": "string" },
            "secretKey": { "type": "string", "minLength": 1 },
            "tokenSecretKey": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["LoadBalancer", "NodePort", "ClusterIP"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "nodePort": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "externalTrafficPolicy": { "type": "string", "enum": ["Local", "Cluster", ""] },
        "loadBalancerIP": { "type": "string" },
        "loadBalancerClass": { "type": "string" },
        "loadBalancerSourceRanges": { "type": "array", "items": { "type": "string" } },
        "annotations": { "type": "object" },
        "labels": { "type": "object" },
        "ipFamilyPolicy": { "type": "string" },
        "ipFamilies": { "type": "array" }
      }
    },
    "managementService": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "annotations": { "type": "object" }, "labels": { "type": "object" } }
    },
    "resources": { "type": "object" },
    "javaOpts": { "type": "string" },
    "extraEnv": { "type": "array" },
    "extraVolumes": { "type": "array" },
    "extraVolumeMounts": { "type": "array" },
    "initContainers": { "type": "array" },
    "extraContainers": { "type": "array" },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "priorityClassName": { "type": "string" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "topologySpreadConstraints": { "type": "array" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "dataVolume": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "sizeLimit": { "type": "string" } }
    },
    "strategy": { "type": "object" },
    "revisionHistoryLimit": { "type": "integer", "minimum": 0 },
    "probes": { "type": "object" },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": ["integer", "string"] },
        "maxUnavailable": { "type": ["integer", "string"] }
      }
    },
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "targetCPUUtilizationPercentage": { "type": ["integer", "string"] },
        "targetPlayersPerPod": { "type": ["integer", "string"] },
        "behavior": { "type": "object" }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "managementFrom": { "type": "array" },
        "egressTo": { "type": "array" }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object" },
        "automountServiceAccountToken": { "type": "boolean" }
      }
    },
    "commonLabels": { "type": "object" }
  },
  "definitions": {
    "duration": {
      "type": ["string", "integer"],
      "pattern": "^(0|[0-9]+(ms|s|m|h|d))$",
      "description": "A Warp duration: 200ms, 30s, 5m, 1h, 30d, or a bare 0."
    }
  }
}
