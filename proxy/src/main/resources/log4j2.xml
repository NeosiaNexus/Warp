<?xml version="1.0" encoding="UTF-8"?>
<!-- shutdownHook disabled: Warp stops Log4j itself, last, so that its shutdown and drain are logged. -->
<Configuration status="WARN" shutdownHook="disable">
    <Properties>
        <Property name="log.dir">logs</Property>
        <!--
          The log file: always plain text. Escape sequences and control characters (but tab and line
          feed) are removed from messages, so that neither a coloured message nor a forged one (a
          name with a carriage return, say) reaches the file as such. A warning or error of Warp
          ends with its code, such as [W-CFG-001], documented in docs/errors.md.
        -->
        <Property name="log.pattern">%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %logger{36} - %replace{%msg}{\x1B(\[[0-?]*[ -/]*[@-~]|\][^\x07\x1B]*(\x07|\x1B\\)|[@-Z\\-_])|[\x00-\x08\x0B-\x1F\x7F-\x9F]}{}%notEmpty{ [%replace{%markerSimpleName}{^(?!W-[A-Z]+-[0-9][0-9][0-9]$).*}{}]}%n</Property>
    </Properties>

    <Appenders>
        <!--
          The console format: warp.log.format, which WarpBootstrap sets before Log4j starts from
          WARP_LOG_FORMAT or logging.format (warp.conf). Chosen once, when the configuration loads:
          nothing is decided per record.
        -->
        <Select>
            <SystemPropertyArbiter propertyName="warp.log.format" propertyValue="json">
                <!-- One JSON object per line: timestamp, level, logger, thread, message, exception, marker (a code such as W-CFG-001), context. -->
                <Console name="Console" target="SYSTEM_OUT">
                    <JsonTemplateLayout eventTemplateUri="classpath:warp-log-layout.json"/>
                </Console>
            </SystemPropertyArbiter>
            <DefaultArbiter>
                <!--
                  Warp's console: colours where the output shows them, the interactive prompt and
                  status line on a real terminal, plain text elsewhere (see ConsoleMode). It writes
                  from a thread of its own: a slow console never holds up the logging thread.
                -->
                <WarpConsole name="Console"/>
            </DefaultArbiter>
        </Select>

        <RollingFile name="File"
                     fileName="${log.dir}/warp.log"
                     filePattern="${log.dir}/warp-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="${log.pattern}"/>
            <Policies>
                <SizeBasedTriggeringPolicy size="50 MB"/>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
            </Policies>
            <DefaultRolloverStrategy max="7"/>
        </RollingFile>
    </Appenders>

    <Loggers>
        <AsyncLogger name="dev.warp" level="INFO" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="File"/>
        </AsyncLogger>

        <AsyncLogger name="io.netty" level="WARN"/>
        <AsyncLogger name="com.google.inject" level="WARN"/>
        <AsyncLogger name="org.spongepowered.configurate" level="WARN"/>

        <AsyncRoot level="INFO">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="File"/>
        </AsyncRoot>
    </Loggers>
</Configuration>
